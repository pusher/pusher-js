{
  "compilerOptions": {
    "sourceMap": true,
    "module": "es6",
    "declaration": true,
    "declarationDir": "types",
    "target": "ES6",
    "removeComments": true,
    "strict": false,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "types": ["node"],
    "moduleResolution": "bundler",
    "paths": {
      "*": [
        "./src/*",
        "./src/runtimes/*"
      ]
    },
    "lib": [
      "ScriptHost",
      "DOM",
      "ES5"
    ]
  },
  "include": ["src", "spec"],
  "exclude": [
    "node_modules"
  ]
}
